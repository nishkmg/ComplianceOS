# ────────────────────────────────────────────────────────────────────────────
# ComplianceOS / Arthvahi — environment template
# Copy to .env and fill in real values. Never commit .env.
# ────────────────────────────────────────────────────────────────────────────

# ─── Runtime ───────────────────────────────────────────────────────────────
# Required. One of: development | test | production
NODE_ENV=development

# ─── Database (required) ───────────────────────────────────────────────────
# Postgres connection string used by web + worker + seed.
DATABASE_URL=postgresql://user:password@localhost:5432/complianceos

# ─── Cache / queue (required) ──────────────────────────────────────────────
# Used by ioredis (rate limiting, projector locks, tRPC cache).
REDIS_URL=redis://localhost:6379

# ─── Auth — NextAuth.js v5 (required) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase (required for auth + storage) ────────────────────────────────
# Project URL (public, also exposed to client as NEXT_PUBLIC_SUPABASE_URL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key (server only — never expose to client). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-jwt

# ─── Email — SMTP (optional in dev) ────────────────────────────────────────
# Used by packages/server/src/services/email-queue.ts (nodemailer).
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@arthvahi.in

# ─── File storage (required for upload routes) ─────────────────────────────
# Driver: "local" (writes to UPLOAD_DIR) or "s3" (uses S3_* below).
STORAGE_DRIVER=local
# Bucket name used by generate-payslip.ts (S3 path prefix).
STORAGE_BUCKET=uploads
# Local-disk root used by file-upload.ts and the /uploads/* route.
UPLOAD_DIR=/tmp/complianceos/uploads
# Public base URL served when STORAGE_DRIVER=s3 (e.g. Supabase Storage public bucket).
S3_PUBLIC_BASE_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/uploads

# ─── Projector worker (required) ───────────────────────────────────────────
# HTTP port for projector worker health server (apps/web/api/health polls it).
PROJECTOR_PORT=3100
# Public URL the web app uses to probe the projector worker.
PROJECTOR_URL=http://localhost:3100

# ─── Sentry (optional) ─────────────────────────────────────────────────────
# DSN exposed to the browser (NEXT_PUBLIC_ → bundled in client).
NEXT_PUBLIC_SENTRY_DSN=
# Org / project for build-time source-map upload in next.config.ts.
SENTRY_ORG=complianceos
SENTRY_PROJECT=complianceos-web

# ─── Demo mode (dev only) ──────────────────────────────────────────────────
# Hard-coded tenant id for the demo seeding flow.
DEMO_TENANT_ID=demo-tenant-uuid
# Exposed to client — when "true", UI shows demo banner + gates destructive actions.
NEXT_PUBLIC_DEMO_MODE=false

# ─── CI / E2E (set by CI only) ─────────────────────────────────────────────
# Standard CI flag — flips retries/workers in playwright.config.ts.
CI=
# Base URL used by Playwright when not running against localhost.
BASE_URL=http://localhost:3000
# web process port (mirrors --port flag for next dev/start).
PORT=3000

# ─── Dev tools ─────────────────────────────────────────────────────────────
# Set to "true" in db:seed:demo scripts to load full demo dataset.
SEED_DEMO=
# Two-factor override for seed gating in CI (both must be set to seed prod-named DBs).
ALLOW_SEED=
ALLOW_PROD_SEED=
