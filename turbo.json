{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "AUTH_URL",
    "AUTH_TRUST_HOST",
    "NEXT_PUBLIC_SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "STORAGE_DRIVER",
    "STORAGE_BUCKET",
    "UPLOAD_DIR",
    "S3_PUBLIC_BASE_URL",
    "PROJECTOR_PORT",
    "PROJECTOR_URL",
    "MAIL_HOST",
    "MAIL_PORT",
    "MAIL_SECURE",
    "MAIL_USER",
    "MAIL_PASS",
    "MAIL_FROM",
    "OCR_PROVIDER",
    "OCR_LLM_API_KEY",
    "OCR_LLM_BASE_URL",
    "OCR_LLM_MODEL",
    "DEMO_TENANT_ID",
    "NEXT_PUBLIC_DEMO_MODE",
    "PORT",
    "BASE_URL",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "REDIS_URL"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}